flowchart LR
  classDef ent fill:#fff,stroke:#333,stroke-width:2px
  classDef proc fill:#e6f4ea,stroke:#3d8b5a,stroke-width:2px
  classDef store fill:#f3e8fd,stroke:#8a55b5

  CL["Clinician"]:::ent
  HN["Hospital nodes H001-H010"]:::ent
  OP["ML engineer"]:::ent
  WH["Alert webhook"]:::ent

  P1(("1.0<br/>Assess patient")):::proc
  P2(("2.0<br/>Log assessment and share counts")):::proc
  P3(("3.0<br/>Detect outbreaks")):::proc
  P4(("4.0<br/>Train federated models")):::proc
  P5(("5.0<br/>Compare and report")):::proc

  D1[("D1 assessments.db")]:::store
  D2[("D2 outbreak.db<br/>summaries and alerts")]:::store
  D3[("D3 Model store")]:::store
  D4[("D4 Hospital encounter<br/>partitions (local only)")]:::store
  D5[("D5 Reports")]:::store

  CL -- "age, gender, vitals, symptoms" --> P1
  P1 -- "disease + probability, atypical flags + reasons,<br/>ranked treatments" --> CL
  D3 -- "trained models" --> P1
  CL -- "severity choice" --> P1

  P1 -- "finished assessment" --> P2
  P2 -- "full record, no patient name" --> D1
  D1 -- "today's cases" --> P2
  P2 -- "per-disease case counts and symptom counts,<br/>ATYP row" --> D2
  CL -- "view history" --> P2
  P2 -- "past assessments, clinic summary" --> CL

  HN -- "daily count summaries (node.py)" --> D2
  CL -- "replay day, acknowledge alert" --> P3
  D2 -- "summaries up to as_of" --> P3
  D3 -- "thresholds" --> P3
  P3 -- "alerts, trends, hospital grid" --> CL
  P3 -- "upsert alerts, resolve stale" --> D2
  P3 -- "new or escalated alert" --> WH

  OP -- "flwr run, task name" --> P4
  D4 -- "rows read inside each hospital" --> P4
  P4 -- "model updates or statistics only" --> D3
  HN -. "participate" .-> P4

  OP -- "run compare / report" --> P5
  D3 -- "federated, local, central models" --> P5
  P5 -- "metrics with confidence intervals" --> D5
  D5 -- "federated overview, comparison" --> CL
